{
  "version": 1,
  "name": "Natural walk and wave",
  "commands": [
    {"op": "project", "width": 960, "height": 540, "fps": 24},
    {"op": "addFigure"},
    {"op": "call", "method": "applyHumanMotion", "args": [{"action": "walk", "duration": 144, "distance": 240, "groundY": 450}], "selection": {"uid": 1}},
    {"op": "call", "method": "applyHumanMotion", "args": [{"action": "wave", "start": 144, "duration": 96, "hand": "left"}], "selection": {"uid": 1}}
  ],
  "output": "agent-human-motion.styk"
}
